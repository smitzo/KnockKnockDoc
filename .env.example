# Prototype V0 only. Do not enter real patient or health data.
PROTOTYPE_MODE=true
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SECRET_KEY=prototype-only-not-for-real-data-change-before-deployment
DATABASE_URL=postgresql://knocknockdoc:local-development-only@db:5432/knocknockdoc
DATABASE_CONN_MAX_AGE=60
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
BACKEND_INTERNAL_URL=http://backend:8000
LOG_LEVEL=INFO
KND_BACKEND_PORT=8000
KND_FRONTEND_PORT=3000
